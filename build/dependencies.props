<Project>

  <PropertyGroup Label="SDK Versions">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible build">
    <Deterministic>true</Deterministic>
    <!-- Normalizes paths inside .pdb/.dll on CI for reproducible output -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package information">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/groupdocs-editor/GroupDocs.Editor.Mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/groupdocs-editor/GroupDocs.Editor.Mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>GroupDocs Contributors</Authors>
    <Company>Aspose</Company>
    <Copyright>Copyright © Aspose Pty Ltd $([System.DateTime]::Now.Year)</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>true</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <GroupDocsEditorMcp>26.10.0</GroupDocsEditorMcp>
  </PropertyGroup>

  <PropertyGroup Label="External Dependency Versions">
    <GroupDocsMcpCore>26.9.0</GroupDocsMcpCore>
    <GroupDocsEditor>26.6.1</GroupDocsEditor>
    <MicrosoftExtensionsHosting>10.0.5</MicrosoftExtensionsHosting>
    <ModelContextProtocol>1.1.0</ModelContextProtocol>
    <MicrosoftSourceLinkGithub>8.0.0</MicrosoftSourceLinkGithub>
    <!-- Security pin: GroupDocs.Editor 26.6.1 (net6.0 assets) pulls System.Security.Cryptography.Pkcs 8.0.0,
         flagged by NuGet audit (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate); 10.0.13 is the first
         patched 10.x release (Signature.Mcp ships the still-flagged 10.0.11). Drop once the engine depends on a patched version. -->
    <SystemSecurityCryptographyPkcs>10.0.13</SystemSecurityCryptographyPkcs>
    <!-- No SkiaSharp pin: GroupDocs.Editor 26.6.1 declares SkiaSharp 3.119.1 + SkiaSharp.NativeAssets.Linux.NoDependencies
         itself, so the Linux natives resolve transitively. Re-check the engine nuspec after every bump. -->
  </PropertyGroup>

  <PropertyGroup Label="NuGet Common Settings">
    <PackageReleaseNotes>https://github.com/groupdocs-editor/GroupDocs.Editor.Mcp/releases/tag/$(GroupDocsEditorMcp)</PackageReleaseNotes>
  </PropertyGroup>

</Project>
